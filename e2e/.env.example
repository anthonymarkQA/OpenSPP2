# Copy to e2e/.env for local runs. Never commit e2e/.env (it's gitignored).
#
# Which target these tests run against: "ephemeral" (a fresh Docker Odoo
# instance, e.g. via `docker compose --profile e2e up`) or "staging" (a
# persistent, real environment with real user accounts).
TEST_TARGET=ephemeral

# Base URL of the Odoo instance under test.
ODOO_URL=http://localhost:8069

# Used when TEST_TARGET=ephemeral. Must match ODOO_ADMIN_PASSWD in
# docker-compose.yml (defaults to admin/admin for a throwaway instance).
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWD=admin

# Used when TEST_TARGET=staging. Real credentials for a persistent
# environment — fill these in locally only, never commit real values.
# In CI these are supplied via GitHub Actions encrypted secrets instead.
SPMIS_STAGING_LOGIN=
SPMIS_STAGING_PASSWORD=
